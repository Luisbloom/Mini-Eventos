<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>Jartiland.TournamentReporter.Tests</RootNamespace>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!--
      Se compila exactamente el mismo código que va dentro de la DLL del plugin.
      Como ../Core no depende de Unity, BepInEx ni EHR, la lógica se prueba entera
      sin abrir Among Us.
    -->
    <ItemGroup>
        <Compile Include="../../src/Core/**/*.cs" LinkBase="Core" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

</Project>
