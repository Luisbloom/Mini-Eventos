# Valores del despliegue actual. No sustituyas la .env existente al actualizar.
HOST=0.0.0.0
PORT=3100

# Ruta persistente. systemd la resuelve desde /opt/jartiland-amongus.
DATA_DIR=data
# DB_PATH=/opt/jartiland-amongus/data/tournament.db

# Producción confía en el único salto proxy configurado.
TRUST_PROXY=1

# URL HTTPS privada de Tailscale Serve que usarán los Tournament Reporter.
# HTTPS 443 y 9443 ya pertenecen a otros servicios; 8443 es el Funnel público.
REPORTER_PRIVATE_URL=https://mini-eventos-jartiland.tail9d0334.ts.net:10000

NODE_ENV=production

# Secreto largo y aleatorio para guardar cambios desde /admin.
# Generar en Debian con: openssl rand -hex 32
ADMIN_TOKEN=cambia-este-token-por-uno-largo-y-aleatorio

# Token global heredado, solo para compatibilidad con Reporter antiguos.
# No debe empezar por jtr_: ese prefijo está reservado para tokens por host.
# Los HOST nuevos deben usar el archivo .ini generado desde /admin.
REPORTER_TOKEN=cambia-este-token-reporter-por-otro-secreto
