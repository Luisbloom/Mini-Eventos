[Unit]
Description=Prueba de restauración de la última copia de Mini Eventos Jartiland
Documentation=file:/opt/jartiland-amongus/README.md
OnFailure=jartiland-alerta@%n.service

[Service]
Type=oneshot
User=jartiland
Group=jartiland
StateDirectory=jartiland-vigilante
StateDirectoryMode=0750
ExecStart=/usr/local/sbin/jartiland-probar-restauracion
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
